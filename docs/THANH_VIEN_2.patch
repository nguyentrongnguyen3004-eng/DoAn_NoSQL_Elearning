+const m2SyncUser = syncUserUI;
+syncUserUI = function () {
+  m2SyncUser();
+  if (currentToken) m2Api('/courses/gamification/check-in', 'POST').then(({ data }) => {
+    if (data.streakSavedByFreeze) showToast('Thẻ Streak Freeze đã được kích hoạt để cứu chuỗi học của bạn!', 'success');
